meta {
  name: Export Monthly Report
  type: http
  seq: 1
}

get {
  url: {{baseURL}}/v1/reports/houses/:house/young-persons/:youngPerson/monthly-report?year=2026&month=2
  body: none
  auth: bearer
}

params:query {
  year: 2026
  month: 2
}

params:path {
  house: 11
  youngPerson: 33
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
