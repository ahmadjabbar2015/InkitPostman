meta {
  name: Upload Monthly Report
  type: http
  seq: 4
}

post {
  url: {{baseURL}}/v1/reports/houses/:house/young-persons/:youngPerson/monthly-reports/:report/upload
  body: multipart
  auth: bearer
}

params:path {
  house: 5
  youngPerson: 22
  report: 1
}

auth:bearer {
  token: {{token}}
}

body:multipart {
  file: @file()
  ~remarks: Reviewed and approved by manager.
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Upload monthly report file for a specific generated YP monthly report record.

  Endpoint:
  POST /v1/reports/houses/:house/young-persons/:youngPerson/monthly-reports/:report/upload

  Purpose:
  - Finalises one generated monthly report by uploading a manager-reviewed Word file.
  - Sets `is_uploaded = true`.
  - Uploaded reports cannot be replaced again.

  Path Parameters:
  - house        (required) House ID.
  - youngPerson  (required) Young person ID; must belong to the same house.
  - report       (required) Monthly report record ID (YpMonthlyReport).
                            Must belong to the same house and young person.

  Body (multipart/form-data):
  - file     (required) Word file (`.docx` or `.doc`), max 10 MB.
  - remarks  (optional) Notes, max 1000 characters.

  Where to get `report` ID:
  - From `Export Monthly Report` response (`data.id`)
  - From `List Monthly Reports` response (`data.reports[].id`)

  Response 200:
  {
    "status": "success",
    "message": "Monthly report uploaded successfully.",
    "data": {
      "id": 1,
      "month": 2,
      "month_name": "February",
      "year": 2026,
      "filename": "Monthly_Report_John_Doe_February_2026_UPLOADED.docx",
      "is_uploaded": true,
      "download_url": "https://...",
      "uploaded_by": { "id": 3, "name": "Staff Name" },
      "uploaded_at": "2026-02-28 11:00:00",
      "remarks": "Reviewed and approved by manager."
    }
  }

  Common errors:
  - 404: Young person or report not found (route model binding).
  - 422: Young person does not belong to the specified house.
  - 422: Report does not belong to the specified young person and house.
  - 422: This report has already been uploaded and cannot be replaced.
  - 422: Validation errors (file missing, invalid type, file too large, remarks too long).
  - 500: Failed to upload monthly report.
}
