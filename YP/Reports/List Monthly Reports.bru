meta {
  name: List Monthly Reports
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/v1/reports/houses/:house/young-persons/:youngPerson/monthly-reports
  body: none
  auth: bearer
}

params:path {
  house: 5
  youngPerson: 22
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Returns all monthly reports that have been generated or uploaded for a specific
  young person in a given house, ordered newest first.

  Path Parameters:
  - house        (required) ID of the house.
  - youngPerson  (required) ID of the young person. Must belong to the given house.

  Response 200:
  {
    "status": "success",
    "message": "Monthly reports retrieved successfully.",
    "data": {
      "reports": [
        {
          "id": 1,
          "month": 2,
          "month_name": "February",
          "year": 2026,
          "filename": "Monthly_Report_John_Doe_February_2026.docx",
          "is_uploaded": false,
          "download_url": "https://...",
          "generated_by": { "id": 3, "name": "Staff Name" },
          "uploaded_by": null,
          "uploaded_at": null,
          "remarks": null,
          "created_at": "2026-02-28 10:00:00",
          "updated_at": "2026-02-28 10:00:00"
        }
      ],
      "young_person": { "id": 22, "name": "John Doe" },
      "house": { "id": 5, "name": "House Name" }
    }
  }

  Response 422: Young person does not belong to the specified house.
  Response 500: Failed to retrieve monthly reports.
}
