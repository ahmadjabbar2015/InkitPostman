meta {
  name: Update Session
  type: http
  seq: 5
}

put {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/keywork-sessions/:id
  body: multipartForm
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 1
  id: 1
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  ~session_datetime: 2025-01-21
  ~session_title: Weekly Check-in Session - Updated
  ~keywork_topic: health
  ~evidence_documents[]: @file(/path/to/document.pdf)
  ~keywork_details: Updated session details
  ~staff_feedback: Young person engaged well with session - updated notes
  ~session_objective_met: yes
  ~manager_wants_followup: yes
  ~manager_comments: Please follow up on medication compliance
  ~next_review: 2025-01-28
}
