meta {
  name: List All Sessions
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/keywork-sessions?session_datetime=2026-02-01
  body: none
  auth: bearer
}

params:query {
  session_datetime: 2026-02-01
  ~page: 1
  ~per_page: 15
}

params:path {
  house: 2
  youngPersonId: 4
}

auth:bearer {
  token: {{token}}
}
