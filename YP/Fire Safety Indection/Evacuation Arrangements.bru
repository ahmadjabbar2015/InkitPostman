meta {
  name: "Fire Safety Induction - Evacuation Arrangement"
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPerson/fire-induction/evacuation-arrangement/14
  body: multipartForm
  auth: bearer
}

params:path {
  house: 4
  youngPerson: 1
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  evacuation_strategy: other
  primary_assembly_point: Front Garden
  primary_assembly_map: @file(C:\Users\Growup Labs\Pictures\download.jpg)
  backup_assembly_point: Parking Area
  backup_assembly_map: @file(C:\Users\Growup Labs\Pictures\download (3).jpg)
  evacuation_strategy_other: The evacuation strategy other field is required.
}
