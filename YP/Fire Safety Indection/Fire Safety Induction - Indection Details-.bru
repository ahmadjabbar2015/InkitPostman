meta {
  name: "Fire Safety Induction - Indection Details"
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/fire-indection/detailssss
  body: multipartForm
  auth: bearer
}

params:path {
  house: 4
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  employee_id: 4
  employee_job_detail_id: 1
  date_of_induction: 2026-01-05
  start_time: 10:00
  end_time: 11:00
  lead_employee_id_one: 3
  lead_employee_id_second: 4
  lead_employee_one_job_id: 1
  lead_employee_two_job_id: 1
  consent_form_received: 0
  fire_alarm_signal_demonstrated: 1
  actions_on_alarm_explained: 1
  escape_routes_and_assembly_point: 1
  fire_doors_usage_explained: 1
  manual_call_points_explained: 1
  actions_on_discovering_fire: 1
  extinguishers_identified: 0
  clear_route_management: 0
  ~consent_form: @file(C:\Users\Growup Labs\Pictures\cute-cat-wearing-sunglasses-and-relaxing-on-orange-chair-generative-ai-illustration-free-photo.jpg)
}
