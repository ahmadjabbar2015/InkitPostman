meta {
  name: Create Plan
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/placement-plans
  body: multipartForm
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 1
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  ~title: Placement Plan Q1 2025
  ~start_date: 2025-01-01
  ~end_date: 2025-03-31
  ~status: active
  ~notes: Initial placement plan for the young person
  ~upload_documents[]: @file(/path/to/document.pdf)
}
