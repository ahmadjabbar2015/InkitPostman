meta {
  name: Update Plan
  type: http
  seq: 4
}

put {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/placement-plans/:id
  body: multipartForm
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 1
  id: 1
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  ~title: Placement Plan Q1 2025 - Updated
  ~start_date: 2025-01-01
  ~end_date: 2025-03-31
  ~status: active
  ~notes: Updated placement plan notes
  ~upload_documents[]: @file(/path/to/document.pdf)
}
