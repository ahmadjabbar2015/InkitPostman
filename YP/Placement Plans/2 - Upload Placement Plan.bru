meta {
  name: 2 - Upload Placement Plan
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/placement-plans
  body: multipartForm
  auth: bearer
}

params:path {
  house: 1
  youngPersonId: 1
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  title: Initial Placement Plan - January 2024
  attachments[0]: @file(/path/to/placement_plan.pdf)
  ~attachments[1]: @file(/path/to/supporting_document.docx)
}
