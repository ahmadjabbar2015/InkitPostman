meta {
  name: Show Action Evidence
  type: http
  seq: 8
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPerson/action-plan/monitoring-evidence/1
  body: none
  auth: bearer
}

params:path {
  youngPerson: 1
  house: 4
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  youngPerson: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
