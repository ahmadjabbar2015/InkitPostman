meta {
  name: Update Action status
  type: http
  seq: 12
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPerson/action-plan/action-status/6
  body: multipartForm
  auth: inherit
}

params:path {
  house: 4
  youngPerson: 1
}

body:multipart-form {
  yp_action_plan_id: 1
  action_completed: 1
  core_plan_update_required: 0
  manager_review_required: 1
  completion_date: 2059-01-15
  outcome: Achieved
  completion_notes: Review progress and update care plan  notess
  manager_signed_off_date: 2036-01-15
  manager_comments: manager commentsss
  evidence_required: 0
  _method: PUT
}

vars:pre-request {
  house: 1
  youngPerson: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
