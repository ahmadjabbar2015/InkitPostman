meta {
  name: Create Feedback (Young Person)
  type: http
  seq: 3
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/feedback-voice
  body: multipartForm
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 1
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  feedback_type: young_person
  ~yp_wishes_feelings: I feel happy living here and I like my room
  ~yp_feelings_about_staff: Staff are really supportive and listen to me
  ~yp_feelings_about_home: The house feels like a safe place
  ~yp_wants_changes: yes
  ~requested_changes: Would like a later bedtime on weekends
  ~attachments[]: @file(/path/to/voice_recording.mp3)
}
