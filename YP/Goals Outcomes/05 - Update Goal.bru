meta {
  name: Update Goal
  type: http
  seq: 5
}

put {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/goals-outcomes/:id
  body: multipartForm
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 1
  id: 1
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  ~goal_category: education
  ~smart_goal: Achieve 90% school attendance by end of term - Updated
  ~why_goal_important: Education is key to future opportunities
  ~steps_to_achieve: Updated steps with additional support measures
  ~plan_start_date: 2025-01-21
  ~review_date: 2025-04-30
  ~progress_made: yes
  ~evidence_documents[]: @file(/path/to/updated_evidence.pdf)
  ~staff_explanation: Continued improvement noted
  ~if_not_achieved: no
}
