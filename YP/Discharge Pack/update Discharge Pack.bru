meta {
  name: update Discharge Pack
  type: http
  seq: 4
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/discharge-pack/95
  body: multipartForm
  auth: inherit
}

params:path {
  youngPersonId: 1
  house: 4
}

body:multipart-form {
  discharge_pack_prepared: yes
  upload_file: @file(C:\Users\Growup Labs\Pictures\Resume.pdf)
  birth_certificate: yes
  passport: no
  id_document: yes
  education_records: yes
  health_records: yes
  medication_summary: yes
  risk_plan: yes
  behaviour_plan: no
  contact_list: yes
  life_story_book: yes
  property_inventory: no
  photos: yes
  custom_pack_item: Extra documents
  data_sharing_method: secure_portal
  recipient_la: yes
  recipient_next_placement: yes
  recipient_yp: yes
  recipient_parent: yes
  recipient_guardian: no
  recipient_health_service: yes
  recipient_education_provider: yes
  confirmation_received: no
  receipt_proof: my name is khannnnnnnnnnn
  follow_up_required: yes
  support_type: Emotional Support
  assigned_to: 4
  start_date: 2026-01-21
  end_date: 2026-02-21
  date_created: 2026-01-20
  prepared_by: 4
  verified_by: 4
}

vars:pre-request {
  house: 1
  youngPerson: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
