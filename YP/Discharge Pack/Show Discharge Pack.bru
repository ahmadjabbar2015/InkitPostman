meta {
  name: Show Discharge Pack
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/discharge-pack/20
  body: none
  auth: bearer
}

params:path {
  youngPersonId: 1
  house: 4
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  youngPerson: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
