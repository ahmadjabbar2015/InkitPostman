meta {
  name: create Discharge Pack
  type: http
  seq: 5
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPerson/discharge-pack
  body: multipartForm
  auth: inherit
}

params:path {
  house: 4
  youngPerson: 1
}

body:multipart-form {
  discharge_pack_prepared: yes
  upload_file: @file(C:\Users\Growup Labs\Pictures\sound-and-fury.pdf)
  birth_certificate: yes
  passport: no
  id_document: yes
  education_records: yes
  health_records: yes
  medication_summary: yes
  risk_plan: no
  behaviour_plan: yes
  contact_list: no
  life_story_book: no
  property_inventory: yes
  photos: yes
  custom_pack_item: Extra documentsssssss
  data_sharing_method: secure_portal
  recipient_la: yes
  recipient_next_placement: yes
  recipient_yp: yes
  recipient_parent: no
  recipient_guardian: no
  recipient_health_service: no
  recipient_education_provider: no
  confirmation_received: no
  receipt_proof: My name is khan
  follow_up_required: yes
  support_type: Emotional Support
  assigned_to: 4
  start_date: 2026-01-21
  end_date: 2026-02-21
  date_created: 2026-01-20
  prepared_by: 4
  verified_by: 4
}

vars:pre-request {
  house: 4
  youngPerson: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
