meta {
  name: YP Handover Next Placement Continuity
  type: http
  seq: 4
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPerson/placement-overview/20/handover-next-placement-continuity
  body: multipartForm
  auth: bearer
}

params:path {
  house: 3
  youngPerson: 1
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  yp_placement_overview_id: 5
  discharge_summary_sent_to: LA
  date_summary_shared: 2026-03-01
  receiving_placement_induction_meeting: yes
  induction_meeting_date: 2026-03-02
  induction_attendees: John Smith, Sarah Khan
  induction_minutes_file: @file(C:\Users\Growup Labs\Pictures\Resume.pdf)
  key_risk_information_shared: yes
  risk_information_file: @file(C:\Users\Growup Labs\Pictures\Report.pdf)
  risk_acknowledged_by: Sarah Khan
  emotional_transition_pack_created: yes
  emotional_transition_pack_file: @file(C:\Users\Growup Labs\Pictures\Resume.pdf)
  followup_contact_agreed: yes
  followup_responsible_staff: John Smith
  followup_date: 2026-03-05
  followup_method: Phone
  closure_confirmation_from_la: yes
  closure_confirmation_file: @file(C:\Users\Growup Labs\Pictures\download (3).jpg)
}

vars:pre-request {
  house: 1
  youngPerson: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
