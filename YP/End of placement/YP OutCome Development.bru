meta {
  name: YP OutCome Development
  type: http
  seq: 5
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPerson/placement-overview/20/outcomes-development
  body: multipartForm
  auth: bearer
}

params:path {
  youngPerson: 1
  house: 3
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  yp_placement_overview_id: 5
  education_training_engagement: Full-Time
  education_current_setting_notes: Enrolled in college program
  emotional_health_outcome: Improved
  emotional_health_notes: Reduced anxiety levels
  social_skills_peer_relationships: Positive
  social_skills_evidence_notes: Healthy peer interactions observed
  independent_living_skills_progress: Other
  other_independent_living_skills: Time management
  therapeutic_work_completed: yes
  therapeutic_summary_file: @file(C:\Users\Growup Labs\Pictures\Report.pdf)
  therapeutic_outcomes: Improved coping strategies
  key_achievement: Completed vocational training
  future_focus_target: Independent living
  recommended_approach_new_setting: Gradual transition with support
}

vars:pre-request {
  house: 1
  youngPerson: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
