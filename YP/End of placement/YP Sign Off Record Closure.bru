meta {
  name: YP Sign Off Record Closure
  type: http
  seq: 7
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPerson/placement-overview/5/sign-off-record-closure
  body: multipartForm
  auth: bearer
}

params:query {
  ~yp_placement_overview_id: 1
}

params:path {
  youngPerson: 1
  house: 3
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  yp_placement_overview_id: 5
  completed_by: Keyworker
  staff_signature: John Smith
  date_completed: 2026-02-10
  qa_reviewed_by: Regional
  final_file_archived: yes
  archive_date: 2026-03-12
  retention_period: 7 Years
  ~damage_claims_list: Broken laptop screen
  ~damage_claims_resolution_plan: Insurance claim raised
  ~financial_handover_completed: 1
  ~financial_handover_receipt: @file(C:\Users\Growup Labs\Pictures\ai-generated-stray-cat-in-danger-background-animal-background-photo.jpg)
  ~safeguarding_pending: 1
  ~safeguarding_date: 2026-02-10
  ~safeguarding_actions_taken: Investigation initiated
  ~safeguarding_summary_file: @file(C:\Users\Growup Labs\Pictures\Resume.pdf)
  ~safeguarding_details: Open complaint with LA
  ~savings_confirmation_file: @file(C:\Users\Growup Labs\Pictures\Resume.pdf)
}

vars:pre-request {
  house: 1
  youngPerson: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
