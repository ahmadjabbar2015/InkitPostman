meta {
  name: show placement overview
  type: http
  seq: 9
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPerson/placement-overview/20
  body: json
  auth: bearer
}

params:query {
  ~yp_admission_id: 4
}

params:path {
  youngPerson: 1
  house: 3
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  yp_admission_id: 4
  placement_status: planned
  placement_type: solo
  date_of_transition_end: 2026-01-25
  local_authority_name: Review progress and update care plan.
  local_authority_phone: whyyyy  progress and update care plan.
  reason_for_move_on: 4
  reason_for_move_on_notes: 4
  risk_level_at_exit: High
  risk_management_outcome_summary: Other
}

vars:pre-request {
  house: 1
  youngPerson: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
