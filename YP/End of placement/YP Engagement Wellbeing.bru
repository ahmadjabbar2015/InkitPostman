meta {
  name: YP Engagement Wellbeing
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPerson/placement-overview/20/engagement-wellbeing
  body: multipartForm
  auth: bearer
}

params:query {
  ~yp_admission_id: 4
}

params:path {
  youngPerson: 1
  house: 3
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "yp_admission_id": 4,
  
    "placement_status": "planned",
    "placement_type": "solo",
  
    "date_of_transition_end": "2026-03-15",
  
    "local_authority_name": "Birmingham City Council",
    "local_authority_phone": "0121-555-8899",
  
    "reason_for_move_on": "developmental_progress",
    "reason_for_move_on_notes": "Young person ready for supported independence.",
  
    "risk_level_at_exit": "low",
    "risk_management_outcome_summary": "Risks reduced through structured support and monitoring."
  }
  
}

body:multipart-form {
  yp_involved_in_transition_planning: no
  reason: YP not ready for transition planning
  advocacy_offered: yes
  yp_feelings_about_move: Anxious but hopeful
  staff_supported_yp_through_transition: Keyworker
  yp_feedback_recorded: yes
  feedback_form: @file(C:\Users\Growup Labs\Pictures\Resume.pdf)
  feedback_summary: YP shared concerns and expectations
  staff_emotional_reflection: YP required reassurance and consistency
  emotional_regulation_progress: Improved
  staff_notes: Progress noted over last 2 weeks
  trauma_triggers_identified: Sudden changes in routine
  key_behaviour_observed: Withdrawal when stressed
  emotional_support_strategies_used: One-to-one sessions and grounding techniques
  ~yp_admission_id: 4
}

vars:pre-request {
  house: 1
  youngPerson: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
