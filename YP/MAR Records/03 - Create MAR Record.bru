meta {
  name: Create MAR Record
  type: http
  seq: 3
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/mar-records
  body: json
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 1
}

auth:bearer {
  token: {{token}}
}

body:json {
  "yp_medication_id": 1,
  "yp_medication_schedule_id": 1,
  "date": "2025-01-21",
  "time_given": "08:00",
  "status": "administered",
  "medication_administered": true,
  "dose_given": 500,
  "dose_unit": "mg",
  "administered_by": 1,
  "witnessed_by": 2,
  "staff_signature": "base64_encoded_signature_here",
  "notes": "Medication given as scheduled"
}
