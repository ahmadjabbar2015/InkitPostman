meta {
  name: Get Stock History
  type: http
  seq: 10
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/medications/:id/stock-history
  body: none
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 1
  id: 1
}

params:query {
  ~page: 1
  ~per_page: 15
}

auth:bearer {
  token: {{token}}
}
