meta {
  name: Discontinue Medication
  type: http
  seq: 8
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/medications/:id/discontinue
  body: json
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 1
  id: 1
}

auth:bearer {
  token: {{token}}
}

body:json {
  "discontinuation_reason": "Course completed successfully",
  "discontinuation_date": "2025-01-28"
}
