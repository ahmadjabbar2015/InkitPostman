meta {
  name: Add Stock
  type: http
  seq: 9
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/medications/:id/add-stock
  body: json
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 1
  id: 1
}

auth:bearer {
  token: {{token}}
}

body:json {
  "quantity": 14,
  "notes": "New prescription received from GP"
}
