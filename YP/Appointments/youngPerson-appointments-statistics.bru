meta {
  name: youngPerson/appointments/statistics
  type: http
  seq: 6
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngperson/appointments/statistics
  body: json
  auth: bearer
}

params:path {
  youngperson: 1
  house: 1
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
