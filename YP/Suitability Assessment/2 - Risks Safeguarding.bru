meta {
  name: 2 - Risks Safeguarding
  type: http
  seq: 2
}

put {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/suitability-assessments/:assessmentId/risks-safeguarding
  body: json
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 1
  assessmentId: 1
}

auth:bearer {
  token: {{token}}
}

