meta {
  name: List Cause of Concern
  type: http
  seq: 1
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/cause-concern
  body: json
  auth: bearer
}

params:path {
  youngPersonId: 1
  house: 4
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  youngPerson: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
