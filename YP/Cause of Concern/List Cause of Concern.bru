meta {
  name: List Cause of Concern
  type: http
  seq: 1
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/cause-concern?concern_datetime=2026-01-21 14:30:00&type_of_concern_id=2
  body: json
  auth: bearer
}

params:query {
  concern_datetime: 2026-01-21 14:30:00
  type_of_concern_id: 2
}

params:path {
  youngPersonId: 1
  house: 4
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  youngPerson: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
