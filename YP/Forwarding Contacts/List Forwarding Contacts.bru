meta {
  name: List Forwarding Contacts
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPerson/forwarding-contacts
  body: none
  auth: bearer
}

params:path {
  youngPerson: 1
  house: 3
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  youngPerson: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
