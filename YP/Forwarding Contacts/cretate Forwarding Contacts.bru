meta {
  name: cretate Forwarding Contacts
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPerson/forwarding-contacts
  body: multipartForm
  auth: inherit
}

params:path {
  house: 3
  youngPerson: 1
}

body:multipart-form {
  forwarding_contact_summary_completed: 1
  placement_contact_name: John Doe
  placement_contact_role: Social Worker
  placement_contact_email: john@gmail.com
  placement_contact_phone: 0123456789
  la_sw_name: Alice Smith
  pa_contact: PA Contact Name
  health_contact: Health Contact Name
  education_contact: Education Contact Name
  emergency_contact: Emergency Contact Name
  key_local_authority_contacts_shared: 1
  method_of_transfer: Email
  transfer_date: 2026-01-20
  yp_given_updated_contact_list_card: 1
  date_provided: 2026-01-20
  signed_by_staff: Staff Name
  health_education_services_notified: 1
  date_of_notification: 2026-01-20
  who_informed: Admin
  upload_confirmation_file: @file(C:\Users\Growup Labs\Pictures\download (2).jpg)
  financial_benefits_agencies_notified: 1
  financial_details: Benefits details
  other_details: Other details
  upload_confirmation_financial: @file(C:\Users\Growup Labs\Pictures\download (1).jpg)
  details: DWP
}

vars:pre-request {
  house: 1
  youngPerson: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
