meta {
  name: List Lado Referrals
  type: http
  seq: 1
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/lado-referrals?created_at=2026-01-27
  body: none
  auth: bearer
}

params:query {
  created_at: 2026-01-27
}

params:path {
  youngPersonId: 1
  house: 4
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  youngPerson: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
