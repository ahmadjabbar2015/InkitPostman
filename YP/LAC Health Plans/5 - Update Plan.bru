meta {
  name: Update Plan
  type: http
  seq: 5
}

put {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/lac-health-plans/:id
  body: multipartForm
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 1
  id: 1
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  ~has_health_assessment_completed: 1
  ~health_assessment_date: 2025-02-15
  ~doctor: Dr. Smith - Updated
  ~summary: Young person is in good health overall - updated notes
  ~outstanding_health_actions: 0
  ~action:
  ~person_responsible:
  ~deadline:
  ~health_recommendations_actioned: 1
  ~immunisation_review_completed: 1
  ~appointment_date: 2025-02-10
  ~missing_vaccines: All vaccines up to date
  ~upload_attachments[]: @file(/path/to/attachment.pdf)
  ~upload_evidence[]: @file(/path/to/evidence.pdf)
}
