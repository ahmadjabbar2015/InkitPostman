meta {
  name: Upload Attachment
  type: http
  seq: 23
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/incidents/:id/attachments
  body: multipartForm
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 1
  id: 1
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  ~file: @file(/path/to/evidence_photo.jpg)
}

docs {
  # Upload Attachment
  
  Upload evidence files (photos, documents, videos, etc.) to an incident record.
  
  ## Request:
  - **Content-Type:** multipart/form-data
  - **Field name:** file
  - **Max size:** 10MB
  
  ## Supported file types:
  - Images: jpg, jpeg, png, gif
  - Documents: pdf, doc, docx
  - Videos: mp4, mov, avi
  - Other: txt, csv, xlsx
  
  ## Response includes:
  - Unique attachment ID
  - Original filename
  - Storage path
  - Upload timestamp
}
