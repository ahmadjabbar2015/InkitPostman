meta {
  name: Update Evidence
  type: http
  seq: 17
}

put {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/incidents/:id/evidences/:evidenceId
  body: formUrlEncoded
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 1
  id: 1
  evidenceId: 5
}

auth:bearer {
  token: {{token}}
}

body:form-urlencoded {
  evidence_type: photo
  description: Updated description - Close-up photo showing extent of bruising
}

docs {
  # Update Evidence Metadata
  
  This endpoint updates the metadata for an existing evidence file.
  **Note:** Cannot change the actual file, only metadata.
  
  ## Request Body:
  - `evidence_type` - Optional - Change evidence type (photo, video, document, audio, other)
  - `description` - Optional - Update description (max 1000 chars)
  
  ## Response:
  Returns the updated evidence record.
}
