meta {
  name: Notify Manager
  type: http
  seq: 25
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/incidents/:id/notify-manager
  body: none
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 1
  id: 1
}

auth:bearer {
  token: {{token}}
}

docs {
  # Notify Manager
  
  Manually trigger manager notification for an incident.
  
  **Note:** Managers are automatically notified when incident severity is set to "major" or "critical" in the incident details step. This endpoint allows for manual notification if needed.
  
  Notifications are sent to all users with "manager" role in the house.
  
  The notification includes:
  - Incident ID and details
  - Young person involved
  - Severity level
  - Date and time of incident
  - Link to view full incident report
}
