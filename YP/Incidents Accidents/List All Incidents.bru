meta {
  name: List All Incidents
  type: http
  seq: 4
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/incidents?incident_datetime=2026-02-01&status=pending
  body: none
  auth: bearer
}

params:query {
  incident_datetime: 2026-02-01
  status: pending
}

params:path {
  house: 2
  youngPersonId: 4
}

auth:bearer {
  token: {{token}}
}
