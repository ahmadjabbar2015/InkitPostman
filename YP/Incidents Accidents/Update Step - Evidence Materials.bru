meta {
  name: Update Step - Evidence Materials
  type: http
  seq: 12
}

put {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/incidents/:id/steps/evidence-materials
  body: json
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 1
  id: 1
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "evidence_materials": "CCTV footage from common room (14:15-15:00) - saved to incident folder\nPhotographs of damaged TV remote control\nWritten statements from two staff members present\nYP's daily log entry from that day"
  }
}

docs {
  # Update Step: Evidence / Supporting Materials
  
  This endpoint updates the list of evidence and supporting materials collected.
  
  ## Fields:
  - `evidence_materials` - Textarea listing all evidence collected
  
  Common evidence types:
  - CCTV footage
  - Photographs
  - Written statements
  - Medical reports
  - Damaged items
  - Documents
  
  Note: Actual files should be uploaded using the separate attachment endpoints.
}
