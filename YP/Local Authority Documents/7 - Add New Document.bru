meta {
  name: 7 - Add New Document
  type: http
  seq: 7
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/local-authority-documents/add
  body: multipartForm
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 9
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  document_name: New document
  attachments[0]: @file(C:\Users\Forrun\Downloads\download (3).pdf)
  attachments[1]: @file(C:\Users\Forrun\Downloads\download (4).pdf)
}

settings {
  encodeUrl: true
  timeout: 0
}
