meta {
  name: 7 - Add New Document
  type: http
  seq: 7
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/local-authority-documents
  body: multipartForm
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 9
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  document_name: care_plan_document
  type: referral_document
  document_category: Legal
  files[]: @file(C:\Users\Forrun\Downloads\download (2).pdf)
}

settings {
  encodeUrl: true
  timeout: 0
}
