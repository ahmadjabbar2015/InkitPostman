meta {
  name: 3 - Show Document
  type: http
  seq: 3
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/local-authority-documents/:document
  body: none
  auth: bearer
}

params:path {
  house: 10
  youngPersonId: 1
  document: 1
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
