meta {
  name: 4 - Update Document
  type: http
  seq: 4
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/local-authority-documents/:document
  body: multipartForm
  auth: bearer
}

params:path {
  house: 10
  youngPersonId: 1
  document: 1
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  document_name: Updated Care Plan 2024
  document_type: Care Plan
  document_category: Legal
  issued_date: 2024-01-15
  expiry_date: 2025-06-15
  issuing_authority: Manchester City Council
  document_reference: LA-CP-2024-001-REV1
  notes: Updated care plan with extended expiry
  ~document_file: @file(/path/to/updated-document.pdf)
  _method: PUT
}

settings {
  encodeUrl: true
  timeout: 0
}
