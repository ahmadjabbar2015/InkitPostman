meta {
  name: 2 - Create Document
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/local-authority-documents
  body: multipartForm
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 9
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  document_name: Care Plan 2024
  type: referral_document
  document_category: Legal
  files[]: @file(C:\Users\Forrun\Downloads\download (4) (1).pdf)
}

settings {
  encodeUrl: true
  timeout: 0
}
