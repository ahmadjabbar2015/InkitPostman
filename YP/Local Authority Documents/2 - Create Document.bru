meta {
  name: 2 - Create Document
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/local-authority-documents
  body: multipartForm
  auth: bearer
}

params:path {
  house: 10
  youngPersonId: 1
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  document_name: Care Plan 2024
  document_type: Care Plan
  document_category: Legal
  issued_date: 2024-01-15
  expiry_date: 2025-01-15
  issuing_authority: Manchester City Council
  document_reference: LA-CP-2024-001
  notes: Annual care plan review document
  document_file: @file(/path/to/document.pdf)
}

settings {
  encodeUrl: true
  timeout: 0
}
