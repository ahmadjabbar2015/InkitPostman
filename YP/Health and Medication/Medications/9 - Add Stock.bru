meta {
  name: 9 - Add Stock
  type: http
  seq: 9
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/medications/:id/add-stock
  body: json
  auth: bearer
}

params:path {
  house: 1
  youngPersonId: 1
  id: 1
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "quantity": 30,
    "notes": "Monthly supply received from pharmacy"
  }
}
