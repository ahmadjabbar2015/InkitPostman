meta {
  name: 8 - Discontinue Medication
  type: http
  seq: 8
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/medications/:id/discontinue
  body: json
  auth: bearer
}

params:path {
  house: 1
  youngPersonId: 1
  id: 1
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "quantity_returned": 10,
    "quantity_destroyed": 5,
    "feedback": "Medication course completed. Young person responded well to treatment. Remaining stock returned to pharmacy."
  }
}
