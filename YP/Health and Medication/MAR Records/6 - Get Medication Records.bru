meta {
  name: 6 - Get Medication Records
  type: http
  seq: 6
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/mar-records/medication/:medicationId
  body: none
  auth: bearer
}

params:path {
  house: 1
  youngPersonId: 1
  medicationId: 1
}

params:query {
  ~start_date: 2024-01-01
  ~end_date: 2024-01-31
  ~page: 1
  ~per_page: 15
}

auth:bearer {
  token: {{token}}
}
