meta {
  name: 2 - Get MAR Sheet
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/mar-records/mar-sheet
  body: none
  auth: bearer
}

params:path {
  house: 1
  youngPersonId: 1
}

params:query {
  start_date: 2024-01-01
  end_date: 2024-01-31
  ~is_prn: 0
  ~medication_name: Paracetamol
}

auth:bearer {
  token: {{token}}
}
