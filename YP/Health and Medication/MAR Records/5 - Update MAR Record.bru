meta {
  name: 5 - Update MAR Record
  type: http
  seq: 5
}

put {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/mar-records/:id
  body: json
  auth: bearer
}

params:path {
  house: 1
  youngPersonId: 1
  id: 1
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "witness_initials": "JS",
    "notes": "Updated notes: Young person experienced mild nausea after taking medication. Monitoring required."
  }
}
