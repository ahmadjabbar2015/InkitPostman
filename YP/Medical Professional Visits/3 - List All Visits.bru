meta {
  name: List All Visits
  type: http
  seq: 3
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/medical-professional-visits
  body: none
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 1
}

params:query {
  ~page: 1
  ~per_page: 15
}

auth:bearer {
  token: {{token}}
}
