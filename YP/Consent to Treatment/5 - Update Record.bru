meta {
  name: Update Record
  type: http
  seq: 5
}

put {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/consent-to-treatment
  body: multipartForm
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 1
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  ~signed_gp_consent_form_uploaded: 1
  ~gp_consent_form: @file(/path/to/updated_gp_consent_form.pdf)
  ~parental_consent_required: 1
  ~legal_basis: care_order
  ~consent_for_emergency_treatment: 1
  ~emergency_instructions: Contact social worker - updated emergency protocol
  ~emergency_restrictions: Updated restrictions as per care plan
  ~consent_for_medication: 1
  ~medication_consent_documents[]: @file(/path/to/updated_medication_consent.pdf)
}
