meta {
  name: Create Record
  type: http
  seq: 5
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/consent-to-treatment
  body: multipartForm
  auth: bearer
}

params:path {
  house: 3
  youngPersonId: 1
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  signed_gp_consent_form_uploaded: yes
  gp_consent_form: @file(C:\Users\Forrun\Downloads\download (1).pdf)
  parental_consent_required: yes
  legal_basis: la
  consent_for_emergency_treatment: yes
  emergency_instructions: Contact social worker and parents immediately
  emergency_restrictions: No blood transfusions without parental consent
  consent_for_medication: yes
  medication_consent_documents[]: @file(C:\Users\Forrun\Downloads\download.pdf)
  parental_consent_document: @file(C:\Users\Forrun\Downloads\download (1).pdf)
  emergency_treatment_document: @file(C:\Users\Forrun\Downloads\download (1).pdf)
}
