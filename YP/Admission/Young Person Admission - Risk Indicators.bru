meta {
  name: "7 - Young Person Admission - Risk Indicators",
  type: http
  seq: 7
}

put {
  url: {{baseURL}}/v1/house/:house/young-persons/admission/:youngPersonId/risk-indicators
  body: json
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 15
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "risk_indicators": [
      {
        "id": null,
        "risk_factor": "CSE",
        "risk_level": "High",
        "description": "History of online grooming concerns",
        "triggers": "Unsupervised phone/internet use",
        "protective_factors": "1:1 support, restricted device access",
        "religion_cultural_info": "Muslim - respects faith boundaries",
        "likes_dislikes_hobbies": "Football, gaming, drawing",
        "distinguishing_marks_height_weight": "Scar on left forearm, 5'6\", 60kg",
        "sort_order": 1
      },
      {
        "id": null,
        "risk_factor": "Absconding",
        "risk_level": "Medium",
        "description": "Two missing episodes in past year",
        "triggers": "After contact with peers from previous area",
        "protective_factors": "Regular activities, positive relationships with staff",
        "sort_order": 2
      }
    ],
    "historical_incidents": [
      {
        "id": null,
        "incident_reference_number": "INC-2024-045",
        "incident_type": "Missing Episode",
        "incident_date": "2024-07-15",
        "incident_details": "Missing for 6 hours - found safe at friend's house",
        "sort_order": 1
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
