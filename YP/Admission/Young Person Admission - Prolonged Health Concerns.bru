meta {
  name: "8 - Young Person Admission - Prolonged Health Concerns (Complete)",
  type: http
  seq: 8
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/admission/:youngPersonId/prolonged-health-concerns
  body: multipartForm
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 9
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  has_disability_sen_learning_need: 1
  disability_type: ADHD
  disability_description: Attention Deficit Hyperactivity Disorder - combined type
  disability_severity: Moderate
  ehcp_upload: @file(C:\Users\Forrun\Downloads\download (6).pdf)
  support_strategies: Movement breaks, visual timetable, quiet space access
  has_non_verbal_communication_need: 0
  key_staff_trained: 1
  training_date: 2025-06-20
  has_allergies: 1
  allergies_list: Peanuts, tree nuts
  reaction_type: Anaphylaxis
  emergency_procedure: Administer EpiPen immediately, call 999
  has_distinguishing_marks: 1
  distinguishing_marks_description: Large birthmark on left forearm, small scar on right knee
  marks_observed_date: 2025-12-01
  ~body_map_upload: @file(/path/to/body-map.png)
}

settings {
  encodeUrl: true
  timeout: 0
}
