meta {
  name: "5 - Young Person Admission - Authority & Legal",
  type: http
  seq: 5
}

put {
  url: {{baseURL}}/v1/house/:house/young-persons/admission/:youngPersonId/authority-legal
  body: multipartForm
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 15
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  local_authorities[0][id]:
  local_authorities[0][local_authority_name]: London Borough of Camden
  local_authorities[0][responsible_department]: Children's Services
  local_authorities[0][local_authority_address]: Judd Street, Camden, London
  local_authorities[0][local_authority_phone]: 020 7974 4444
  local_authorities[0][local_authority_email]: childrenservices@camden.gov.uk
  local_authorities[0][out_of_hours_phone]: 020 7974 4000
  local_authorities[0][is_primary]: 1
  local_authorities[0][sort_order]: 1
  key_contacts[0][id]:
  key_contacts[0][role]: Social Worker
  key_contacts[0][name]: Jane Smith
  key_contacts[0][phone]: 020 7974 1234
  key_contacts[0][email]: jane.smith@camden.gov.uk
  key_contacts[0][team_name]: Children's Social Care Team
  key_contacts[0][out_of_hours_role]: Duty Social Worker
  key_contacts[0][is_current]: 1
  key_contacts[0][sort_order]: 1
  key_contacts[1][id]:
  key_contacts[1][role]: Independent Reviewing Officer
  key_contacts[1][name]: Robert Lee
  key_contacts[1][phone]: 020 7974 5678
  key_contacts[1][email]: robert.lee@camden.gov.uk
  key_contacts[1][team_name]: IRO Service
  key_contacts[1][is_current]: 1
  key_contacts[1][sort_order]: 2
  legal_contacts[0][id]:
