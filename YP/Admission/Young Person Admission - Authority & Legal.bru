meta {
  name: "5 - Young Person Admission - Authority & Legal",
  type: http
  seq: 5
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/admission/:youngPersonId/authority-legal
  body: multipartForm
  auth: bearer
}

params:path {
  house: 10
  youngPersonId: 1
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
