  legal_contacts[0][address]: 101 Legal Street, Westminster
  legal_contacts[0][address_line_1]: London
  legal_contacts[0][postcode]: WC1A 1AA
  legal_contacts[0][letter_of_authority]: @file(/home/pirate-king/Documents/sample.pdf)
