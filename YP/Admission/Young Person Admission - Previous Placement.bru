meta {
  name: "6 - Young Person Admission - Previous Placement",
  type: http
  seq: 6
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/admission/:youngPersonId/previous-placement
  body: multipartForm
  auth: bearer
}

params:path {
  house: 4
  youngPersonId: 15
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  has_previous_placement: 1
  placement_name: Sunshine Children's Home
  address: 456 Care Avenue, Manchester
  type: Residential Home
  start_date: 2023-01-10
  end_date: 2024-08-30
  reason_for_leaving: Planned transition to current placement
  report_attachment: @file(C:\Users\Forrun\Downloads\download (3).pdf)
}

settings {
  encodeUrl: true
  timeout: 0
}
