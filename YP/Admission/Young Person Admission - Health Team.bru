meta {
  name: "3 - Young Person Admission - Health Team",
  type: http
  seq: 3
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/admission/:youngPersonId/health-team
  body: json
  auth: bearer
}

params:path {
  house: 10
  youngPersonId: {{young_person_id}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {"health_teams": [
    {
      "health_practitioner_type": "GP",
      "name": "Dr. Sarah Johnson",
      "phone": "020 1234 5678",
      "email": "sarah@gppractice.nhs.uk",
      "practice_name": "City Health Centre",
      "address": "789 Health Street",
      "address_line_1": "London",
      "postcode": "W1A 1AA",
      "remarks": "Registered GP - regular check-ups"
    },
    {
      "health_practitioner_type": "Dentist",
      "name": "Dr. Mike Brown",
      "phone": "020 8765 4321",
      "email": "mike@smiledental.co.uk",
      "practice_name": "Smile Dental Clinic",
      "remarks": "Last visit: June 2025"
    },
    {
      "health_practitioner_type": "Optician",
      "name": "Vision Express",
      "practice_name": "High Street Opticians",
      "remarks": "Wears glasses"
    }
  ]}
}

settings {
  encodeUrl: true
  timeout: 0
}
