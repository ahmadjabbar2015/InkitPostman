meta {
  name: "1 - Young Person Admission - Personal Details",
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/admission/personal-details
  body: multipartForm
  auth: bearer
}

params:path {
  house: 10
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  first_name: Ahmad
  ~middle_name: Jabba
  last_name: Khan
  ~preferred_name: Ahmad
  ~name_initials: AJK
  ~child_id: YP-2025-00123
  ~ni_number: YN123456A
  ~nhs_number: 123 456 7890
  ~older_number:
  date_of_birth: 2010-05-15
  ~age: 15
  gender: Male
  ~pronouns: He/Him
  ~nationality: British
  ~nationality_1: Pakistani
  ~nationality_2:
  ~ethnicity: Asian - Pakistani
  ~religion: Islam
  ~culture: Pakistani
  ~cultural_customs: Observes Ramadan, requires prayer space
  ~dietary_requirements: Halal only, no pork
  ~worship_need: Prayer mat and quiet space required
  ~phone: 07123456789
  ~email: ahmad.khan@mailinator.com
  ~profile_picture: @file(/home/pirate-king/Pictures/Screenshots/Screenshot from 2025-12-18 17-25-49.png)
  ~parental_consent_form:
  ~dols_order_attachment:
  ~legal_status: Section 20
  ~other_legal_status:
  ~dols_required: 0
  ~dols_order_number:
  ~restrictions_applied:
  ~authorising_body:
  ~responsible_local_authority_name: Manchester City Council
  ~consent_given_by: Parent/Guardian
  ~consent_date: 2024-12-01
  ~iro_name: Jane Smith
  ~iro_contact: jane.smith@manchester.gov.uk
  ~advocate_appointed: 1
  ~advocate_name: John Doe
  ~advocate_contact: john.doe@advocacy.org.uk
  ~start_date: 2024-12-15
  ~review_date: 2025-03-15
  ~notes: New admission, requires settling-in period monitoring
  ~significant_marks: Small scar on left knee
  ~eye_color: Brown
  ~hair_color: Black
}

settings {
  encodeUrl: true
  timeout: 0
}
