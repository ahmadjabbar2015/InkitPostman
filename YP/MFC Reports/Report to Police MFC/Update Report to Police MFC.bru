meta {
  name: Update Report to Police MFC
  type: http
  seq: 3
}

put {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/mfc-reports/:id
  body: json
  auth: bearer
}

params:path {
  house: 2
  youngPersonId: 4
  id: 3
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "status": "returned",
    "actions_to_locate_yp": "Police investigation ongoing, YP located and returned safely"
  }
}
