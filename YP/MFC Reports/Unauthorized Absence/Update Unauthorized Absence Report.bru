meta {
  name: Update Unauthorized Absence Report
  type: http
  seq: 3
}

put {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/mfc-reports/:id
  body: json
  auth: bearer
}

params:path {
  house: 2
  youngPersonId: 4
  id: 1
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "status": "active",
    "actions_to_locate_yp": "Police notified, additional searches conducted",
    "missing_protocol_update_needed": "yes"
  }
}
