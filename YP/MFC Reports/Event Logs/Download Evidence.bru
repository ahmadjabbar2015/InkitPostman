meta {
  name: Download Evidence
  type: http
  seq: 6
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/mfc-reports/:id/event-logs/:eventLogId/evidence/:evidenceId/download
  body: none
  auth: bearer
}

params:path {
  house: 2
  youngPersonId: 4
  id: 1
  eventLogId: 1
  evidenceId: 1
}

auth:bearer {
  token: {{token}}
}
