meta {
  name: Get Single Event Log
  type: http
  seq: 3
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/mfc-reports/:id/event-logs/:eventLogId
  body: none
  auth: bearer
}

params:path {
  house: 2
  youngPersonId: 4
  id: 1
  eventLogId: 1
}

auth:bearer {
  token: {{token}}
}
