meta {
  name: Update Event Log
  type: http
  seq: 4
}

put {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/mfc-reports/:id/event-logs/:eventLogId
  body: json
  auth: bearer
}

params:path {
  house: 2
  youngPersonId: 4
  id: 1
  eventLogId: 1
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "event_description": "Called YP's mobile phone - answered this time",
    "action_taken": "Spoke with YP, requested return to home",
    "outcome": "YP agreed to return within 2 hours"
  }
}
