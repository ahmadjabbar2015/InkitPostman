meta {
  name: Update Event Log
  type: http
  seq: 4
}

put {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/mfc-reports/:id/event-logs/:eventLogId
  body: multipartForm
  auth: bearer
}

params:path {
  house: 2
  youngPersonId: 4
  id: 1
  eventLogId: 1
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  event_datetime: 2026-01-23 16:30:00
  person_contacted: Police Officer Johnson
  advice: Updated advice received from police
  evidence: @file(/path/to/updated-evidence.pdf)
  event_log: Updated log with new information from police contact
  return_informed: true
  informed_datetime: 2026-01-23 17:00:00
  informed_person: Social Worker Jane Doe
  contact_method: email
  informed_by: John Smith
}
