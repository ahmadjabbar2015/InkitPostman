meta {
  name: Create Event Log
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/mfc-reports/:id/event-logs
  body: json
  auth: bearer
}

params:path {
  house: 2
  youngPersonId: 4
  id: 1
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "event_datetime": "2026-01-23 14:30:00",
    "event_type": "contact_attempt",
    "event_description": "Called YP's mobile phone - no answer",
    "action_taken": "Left voicemail requesting return call",
    "outcome": "No response yet",
    "staff_involved": "John Doe"
  }
}
