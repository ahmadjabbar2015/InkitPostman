meta {
  name: youngPerson/plan-record/attachments/add
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPerson/plan-record/attachment-documents/add
  body: form-data
  auth: bearer
}

params:path {
  house: 1
  youngPerson: 1
}

auth:bearer {
  token: {{token}}
}

body:form-data {
  document_name: "Medical Report",
  attachments[0]: file, /path/to/file1.pdf
  attachments[1]: file, /path/to/file2.jpg
  attachments[2]: file, /path/to/file3.docx
  attachments[3]: file, /path/to/file4.png
  attachments[4]: file, /path/to/file5.pdf
}

settings {
  encodeUrl: true
  timeout: 0
}
