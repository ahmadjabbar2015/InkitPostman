meta {
  name: YP Professional Network Review
  type: http
  seq: 3
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPerson/placement-overview/5/professional-network-review
  body: multipartForm
  auth: bearer
}

params:query {
  ~yp_placement_overview_id: 1
}

params:path {
  youngPerson: 1
  house: 3
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  yp_placement_overview_id: 5
  professional_engagement: 1
  professional_engagement_summary: Social worker and therapist involved
  inter_professional_communication_rating: Consistent
  delays_or_barriers: 1
  coordination_description: Delay in response from LA
  action_taken: Follow-up calls and escalation
  information_pack_files: @file(C:\Users\Growup Labs\Pictures\Report.pdf)
  support_continuity_arranged: 1
  contact_name: Sarah Williams
  information_pack_sent: 1
}

vars:pre-request {
  house: 1
  youngPerson: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
