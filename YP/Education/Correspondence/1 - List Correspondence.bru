meta {
  name: 1 - List Correspondence
  type: http
  seq: 1
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPerson/correspondence?per_page=15
  body: none
  auth: bearer
}

params:path {
  house: 2
  youngPerson: 4
}

params:query {
  per_page: 15
  ~type: Email
  ~does_require_action: yes
  ~from_date: 2024-01-01
  ~to_date: 2024-12-31
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
