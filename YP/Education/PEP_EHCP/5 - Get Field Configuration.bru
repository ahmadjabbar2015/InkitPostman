meta {
  name: Get PEP/EHCP Field Configuration
  type: http
  seq: 5
}

get {
  url: {{baseURL}}/v1/house/:houseId/young-persons/:youngPersonId/pep-ehcp/field-configuration
  body: none
  auth: bearer
}

params:path {
  youngPersonId: 4
  houseId: 2
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  # Get PEP/EHCP Field Configuration
  
  Returns the form configuration for PEP (Personal Education Plan) and EHCP (Education Health Care Plan) modules.
  
  Includes two main sections:
  - PEP section with meeting details, targets, and actions
  - EHCP section with needs, outcomes, and amendments
}
