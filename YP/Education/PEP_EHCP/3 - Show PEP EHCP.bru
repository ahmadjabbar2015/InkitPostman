meta {
  name: 3 - Show PEP EHCP
  type: http
  seq: 3
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPerson/pep-ehcp/:pepEhcp
  body: none
  auth: bearer
}

params:path {
  house: 2
  youngPerson: 4
  pepEhcp: 1
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
