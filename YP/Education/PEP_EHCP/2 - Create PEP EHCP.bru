meta {
  name: 2 - Create PEP EHCP
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPerson/pep-ehcp
  body: multipartForm
  auth: bearer
}

params:path {
  house: 2
  youngPerson: 4
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  latest_pep_meeting_completed: yes
  pep_date: 2026-01-12
  pep_attendees: John Wick, Steve Smith
  pep_summary: It is a long established fact that a reader will be distracted by the readable content of a page when looking at its layout.
  pep_targets: It is a long established fact that a reader will be distracted by the readable content of a page when looking at its layout.
  pep_document: @file(/home/umer/Pictures/Screenshots/Screenshot from 2025-12-29 12-49-41.png)
  have_pep_actions_implemented_at_home: yes
  pep_action: Dummy
  pep_staff_responsible: Steve Smith
  pep_review_date: 2026-01-12
  does_yp_have_ehcp: yes
  ehcp_areas_of_need: Dummy
  ehcp_current_outcomes: It is a long established fact that a reader will be distracted by the readable content of a page when looking at its layout.
  ehcp_responsibilities: It is a long established fact that a reader will be distracted by the readable content of a page when looking at its layout.
  ehcp_attachment: @file(/home/umer/Pictures/Screenshots/Screenshot from 2025-12-30 17-32-53.png)
  are_new_amendments_requested: yes
  ehcp_reason: It is a long established fact that a reader will be distracted by the readable content of a page when looking at its layout.
  ehcp_evidence: @file(/home/umer/Pictures/Screenshots/Screenshot from 2025-12-31 16-32-13.png)
}

settings {
  encodeUrl: true
  timeout: 0
}
