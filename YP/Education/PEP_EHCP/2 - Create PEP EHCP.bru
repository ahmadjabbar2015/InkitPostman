meta {
  name: 2 - Create PEP Action
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPerson/pep-ehcp
  body: multipartForm
  auth: bearer
}

params:path {
  house: 2
  youngPerson: 4
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  ~have_pep_actions_implemented_at_home: yes
  ~pep_action: Dummy action to implement at home
  ~pep_staff_responsible[]: 1
  ~pep_staff_responsible[]: 2
  ~pep_review_date: 2026-01-12
  ~pep_records[0][latest_pep_meeting_completed]: yes
  ~pep_records[0][pep_date]: 2026-01-12
  ~pep_records[0][pep_attendees]: John Wick, Steve Smith
  ~pep_records[0][pep_summary]: It is a long established fact that a reader will be distracted by the readable content of a page when looking at its layout.
  ~pep_records[0][pep_targets]: It is a long established fact that a reader will be distracted by the readable content of a page when looking at its layout.
  ~pep_records[0][pep_document]: @file(/home/umer/Pictures/Screenshots/Screenshot from 2025-12-29 12-49-41.png)
  ~pep_records[1][latest_pep_meeting_completed]: yes
  ~pep_records[1][pep_date]: 2026-01-20
  ~pep_records[1][pep_attendees]: Jane Doe, Mike Johnson
  ~pep_records[1][pep_summary]: Second PEP record summary
  ~pep_records[1][pep_targets]: Second PEP record targets
  ~ehcp_records[0][does_yp_have_ehcp]: yes
  ~ehcp_records[0][ehcp_areas_of_need]: Communication and interaction
  ~ehcp_records[0][ehcp_current_outcomes]: It is a long established fact that a reader will be distracted by the readable content of a page when looking at its layout.
  ~ehcp_records[0][ehcp_responsibilities]: It is a long established fact that a reader will be distracted by the readable content of a page when looking at its layout.
  ~ehcp_records[0][ehcp_attachment]: @file(/home/umer/Pictures/Screenshots/Screenshot from 2025-12-30 17-32-53.png)
  ~ehcp_records[0][are_new_amendments_requested]: yes
  ~ehcp_records[0][ehcp_reason]: It is a long established fact that a reader will be distracted by the readable content of a page when looking at its layout.
  ~ehcp_records[0][ehcp_evidence]: @file(/home/umer/Pictures/Screenshots/Screenshot from 2025-12-31 16-32-13.png)
  ~ehcp_records[1][does_yp_have_ehcp]: yes
  ~ehcp_records[1][ehcp_areas_of_need]: Cognition and learning
