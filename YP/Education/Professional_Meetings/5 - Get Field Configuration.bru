meta {
  name: Get Professional Meetings Field Configuration
  type: http
  seq: 5
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/education-professional-meetings/field-configuration
  body: none
  auth: bearer
}

params:path {
  youngPersonId: 2
  house: 4
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  # Get Professional Meetings Field Configuration
  
  Returns the form configuration for the professional meetings module.
  
  Includes:
  - meeting_type options (PEP, EHCP Review, Annual Review, Parent Evening, etc.)
  - therapy_updates options (Ongoing, Completed, Pending, Not Required)
  
  Four main sections:
  - Meeting Details
  - Key Discussion Points
  - Actions / Impact Summary
  - Manager Oversight
}
