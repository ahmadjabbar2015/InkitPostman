meta {
  name: Get Transport Field Configuration
  type: http
  seq: 5
}

get {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPersonId/transport/field-configuration
  body: none
  auth: bearer
}

params:path {
  house: 2
  youngPersonId: 4
}

