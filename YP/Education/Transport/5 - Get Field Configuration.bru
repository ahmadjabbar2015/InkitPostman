meta {
  name: Get Transport Field Configuration
  type: http
  seq: 5
}

get {
  url: {{BASE_URL}}/house/{{HOUSE_ID}}/young-persons/{{YOUNG_PERSON_ID}}/transport/field-configuration
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

docs {
  # Get Transport Field Configuration
  
  Returns the form configuration for the transport module including staff transport and taxi/escort arrangements with risk assessment fields.
}
