meta {
  name: Create Education Support & Impact
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/v1/house/:house/young-persons/:youngPerson/education-support-impact
  body: multipartForm
  auth: inherit
}

params:path {
  house: 2
  youngPerson: 4
}

body:multipart-form {
  daily_homework_support_provided: yes
  duration: Evening
  additional_learning_materials_used: Online courses and workbooks
  yp_engaged_learning_at_home: Engaged in mathematics and reading activities
  has_support_improved_attendance: yes
  has_behaviour_improved: yes
  provider_feedback: It is a long established fact that a reader will be distracted by the readable content of a page when looking at its layout.
  has_mental_emotional_state_improved: yes
  are_new_concerns_raised: yes
  summary: Overall positive impact with some new concerns raised regarding specific subjects
  motivations_used: Rewards and incentives for completed work
  barriers_to_engagement: Difficulty focusing on specific subjects
  yp_feedback: It is a long established fact that a reader will be distracted by the readable content of a page when looking at its layout.
  ~upload_evidence: @file(/home/umer/Pictures/Screenshots/Screenshot from 2025-12-29 13-22-39.png)
  ~attendance_evidence: @file(/home/umer/Pictures/Screenshots/Screenshot from 2025-12-29 13-27-35.png)
}
