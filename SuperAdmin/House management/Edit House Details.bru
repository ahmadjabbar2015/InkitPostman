meta {
  name: Edit House Details
  type: http
  seq: 6
}

post {
  url: {{baseURL}}/v1/house/:houseId
  body: multipartForm
  auth: bearer
}

params:path {
  houseId: 4
}

auth:bearer {
  token: {{token}}
}

