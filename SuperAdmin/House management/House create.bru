meta {
  name: House create
  type: http
  seq: 3
}

post {
  url: {{baseURL}}/v1/house
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  houseName: Yoyo House
  houseContactNumber: 45645654
  countryId: 1
  cityId: 5
  houseAddress: 123 Green Street, London
  postcode: NW1 5DB
  clientId: 10
  houseStaticIp: 192.168.1.101
  housePrefix: MYP
  workingStartTime: 09:00
  workingEndTime: 18:00
  createOfstedLogin: 1
  createReg44Login: 0
  isHeadoffice: 0
  isInternalAgencyHouse: 1
  : 
  letterheadHeader: @file(/home/umer/Pictures/Screenshots/Screenshot from 2025-12-30 17-59-19.png)
  letterheadFooter: @file(/home/umer/Pictures/Screenshots/Screenshot from 2025-12-30 17-59-27.png)
  ~image: @file()
  ~letterheadFormat: @file()
}
