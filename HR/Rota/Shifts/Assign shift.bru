meta {
  name: Assign shift
  type: http
  seq: 4
}

post {
  url: {{baseURL}}/v1/house/:house/shifts/assign
  body: json
  auth: inherit
}

params:path {
  house: 11
}

body:json {
  {
    "shiftId": 3,
    "employeeJobId": 2,
    "teamLead": true,
    "shiftDate": "2025-11-16",
    "comments" : "Assigning shift comment"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
