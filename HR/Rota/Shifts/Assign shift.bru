meta {
  name: Assign shift
  type: http
  seq: 4
}

post {
  url: {{baseURL}}/v1/house/:house/shifts/assign
  body: json
  auth: inherit
}

params:path {
  house: 10
}

body:json {
  {
    "shiftId": 15,
    "employeeJobId": 3,
    "teamLead": true,
    "shiftDate": "2025-11-29",
    "comment" : "My shift"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
