meta {
  name: Create Shifts
  type: http
  seq: 8
}

post {
  url: {{baseURL}}/v1/house/:house/shifts
  body: json
  auth: inherit
}

params:path {
  house: 10
}

body:json {
  {
    "houseId": 11,
    "shiftName": "Evening Shift",
    "startTime": "04:00",
    "endTime": "22:00",
  //   "weekStartDate": "2025-11-10",
    "comment": "First week schedule",
    "isRecurring": true // true For adding the shifts that will go in every week
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
