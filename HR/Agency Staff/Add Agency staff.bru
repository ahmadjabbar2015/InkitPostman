meta {
  name: Add Agency Staff
  type: http
  seq: 4
}

post {
  url: {{baseURL}}/v1/house/:house/agency-staff
  body: multipartForm
  auth: inherit
}

params:path {
  house: 10
}

body:multipart-form {
  title: Mr
  firstName: Agency
  lastName: Staff 1
  gender: Male
  contactNo: +447911123456
  email: agency.employee1@gmail.com
  agencyName: CarePlus Agency Ltd
  inductionDate: 2025-11-15
  profileAttachmentFile: @file(/home/pirate-king/Pictures/Screenshots/Screenshot from 2025-10-15 11-59-46.png)
  documentAttachmentFile: @file(/home/pirate-king/Pictures/Screenshots/Screenshot from 2025-10-15 11-59-46.png)
  loginAccess: 1
  houseJobTitleId: 24
}

settings {
  encodeUrl: true
  timeout: 0
}
