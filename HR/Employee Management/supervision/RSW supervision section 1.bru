meta {
  name: RSW supervision section 1
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/v1/house/:house/employees/:userID/job/:jobId/supervisions/:supervision/save-sections-responses
  body: json
  auth: bearer
}

params:path {
  supervision: 2
  jobId: 1
  userID: 25
  house: 10
}

auth:bearer {
  token: {{token}}
}

body:json {
  
  
  {
    "section_id": 92,
    "agenda_items": [1, 2, 3],
    "custom_agenda_items": [
      {
        "text": "Custom topic 1",
        "is_checked": true
      },
      {
        "text": "Custom topic 2",
        "is_checked": false
      }
    ],
    "professional_discussions": [
      {
        "topic": "Workload management",
        "summary": "Discussed current workload and strategies for better time management",
        "follow_up": "Review in next supervision",
        "timescale": "2024-02-01",
        "action": "Implement time blocking technique"
      }
    ]
  }
}
