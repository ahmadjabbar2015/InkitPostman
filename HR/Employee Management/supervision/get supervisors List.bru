meta {
  name: get supervisors List
  type: http
  seq: 18
}

get {
  url: {{baseURL}}/v1/house/:house/employees/:userID/job/:jobDetailsId/supervisions/supervisors
  body: none
  auth: bearer
}

params:query {
  ~supervisor_id: 2
}

params:path {
  jobDetailsId: 1
  house: 10
  userID: 25
}

auth:bearer {
  token: {{token}}
}
