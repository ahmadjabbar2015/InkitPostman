meta {
  name: RSW supervision section 9
  type: http
  seq: 11
}

post {
  url: {{baseURL}}/v1/house/:house/employees/:userID/job/:jobId/supervisions/:supervision/save-sections-responses
  body: json
  auth: bearer
}

params:path {
  supervision: 1
  jobId: 2
  userID: 30
  house: 23
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "section_id": 51,
    "employee_supervision_training_and_developments": [
      {
        "topic": "Professional and respectful at all times",
        "staff_comment": "Committed to professional development",
        "supervisor_notes": "Strong team player with good initiative",
        "supervisor_rating": 5
      }
    ]
  }
}
