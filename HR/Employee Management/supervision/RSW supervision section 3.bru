meta {
  name: RSW supervision section 3
  type: http
  seq: 3
}

post {
  url: {{baseURL}}/v1/house/:house/employees/:userID/job/:jobId/supervisions/:supervision/save-sections-responses
  body: json
  auth: bearer
}

params:path {
  supervision: 5
  jobId: 1
  userID: 34
  house: 11
}

auth:bearer {
  token: {{token}}
}

body:json {
