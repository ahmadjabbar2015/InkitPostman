meta {
  name: RSW supervision section 2
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/v1/house/:house/employees/:userID/job/:jobId/supervisions/:supervision/save-sections-responses
  body: json
  auth: bearer
}

params:path {
  supervision: 5
  jobId: 1
  userID: 34
  house: 11
}

auth:bearer {
  token: {{token}}
}

