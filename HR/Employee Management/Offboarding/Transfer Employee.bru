meta {
  name: Transfer Employee
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/v1/house/:house/employees/:employee/job/:jobId/offboarding/transfer
  body: multipartForm
  auth: bearer
}

params:path {
  house: 13
  employee: 27
  jobId: 2
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  transferDate: 2025-12-04
  interviewDate: 2025-12-05
  remarks: Great employee
  newHouseId: 18
  newHouseRoleId: 219
  newJobTitleId: 35
  newEmploymentType: Full Time
  newEmploymentStartDate: 2025-12-04
  newEmploymentSalaryType: per_annum
  newSalary: 25000
  employeeStatus: Inactive
  p45DocumentStatus: applied
  p45Document: @file(/home/pirate-king/Downloads/Atif%20Rizwan%20Resume%20updated..pdf)
  transferLetter: @file(/home/pirate-king/Downloads/Abdul_Wasay-Resume.pdf)
}
