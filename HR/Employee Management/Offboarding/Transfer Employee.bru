meta {
  name: Transfer Employee
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/v1/house/:house/employees/:employee/job/:jobId/offboarding/transfer
  body: multipartForm
  auth: bearer
}

params:path {
  house: 10
  employee: 26
  jobId: 2
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  transferDate: 2025-12-04
  interviewDate: 2025-12-05
  remarks: Great employee
  newHouseId: 12
  newHouseRoleId: 7
  newJobTitleId: 4
  newEmploymentType: Full Time
  newEmploymentStartDate: 2025-12-04
  newEmploymentSalaryType: per_annum
  newSalary: 25000
  employeeStatus: Active
  ~userId: 26
  ~employeeJobId: 2
  ~interviewNotes: @file(/home/pirate-king/Pictures/Screenshots/interview-notes.png)
  ~transferLetter: @file(/home/pirate-king/Pictures/Screenshots/transfer-letter.pdf)
}
