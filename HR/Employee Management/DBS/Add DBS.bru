meta {
  name: Add DBS
  type: http
  seq: 3
}

post {
  url: {{baseURL}}/v1/house/:house/employees/:employee/job/:JobId/dbs
  body: multipartForm
  auth: inherit
}

params:path {
  JobId: 3
  house: 9
  employee: 29
}

body:multipart-form {
  dbsInformation: New DBS Applied
  applicationDate: 2023-01-15
  issuedBy: Disclosure & Barring Service
  dbsLevel: Enhanced
  dbsWorkforce: Child Workforce
  dbsStatus: New DBS Applied
  ~employeeJobId: 6
  ~issuanceDate: 2023-02-01
  ~dbsNumber: DBS123456789
  ~convictionDetails: Candidate had a minor offense in 2010, cleared after legal review.
  ~riskAssessment: true
  ~dbsOnUpdateService: Yes
  ~checkedBy: HR Manager
  ~mostRecentCheckDate: 2024-12-01
  ~upcomingCheckDate: 2025-12-01
  ~nextCheckDate: 2026-12-01
  ~dbsCertificateAttachment: @file(/home/pirate-king/Pictures/Screenshots/Screenshot from 2025-10-15 11-59-46.png)
  ~riskAssessmentAttachment: @file(/home/pirate-king/Pictures/Screenshots/Screenshot from 2025-09-04 18-04-12.png)
  ~documentForDbsUpdateServiceAttachment: @file(/home/pirate-king/Pictures/Screenshots/Screenshot from 2025-09-04 18-04-12.png)
  ~files[]: @file(/home/pirate-king/Pictures/Screenshots/Screenshot from 2025-09-04 18-04-12.png)
  ~files[]: @file(/home/pirate-king/Pictures/Screenshots/Screenshot from 2025-09-04 18-04-12.png)
  ~description: Lorem Ipsum
}

settings {
  encodeUrl: true
  timeout: 0
}
