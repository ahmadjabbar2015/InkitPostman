meta {
  name: Existing DBS
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/v1/house/:house/employees/:employee/job/:JobId/dbs
  body: multipartForm
  auth: inherit
}

params:path {
  JobId: 6
  house: 8
  employee: 29
}


body:multipart-form {
  employeeJobId: 6
  dbsInformation: NEW_DBS_APPLIED
