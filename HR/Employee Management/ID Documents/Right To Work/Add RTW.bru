meta {
  name: Add RTW
  type: http
  seq: 3
}

post {
  url: {{baseURL}}/v1/house/:house/employees/:employee/job/:JobId/rtw
  body: multipartForm
  auth: inherit
}

params:path {
  JobId: 1
  house: 12
  employee: 26
}

body:multipart-form {
  shareCode: XY123Z456
  dateOfCheck: 2026-10-16
  workAllowedUntil: 2026-10-16
  workPermission: skilled_worker_visa
  otherPermissionDetails: 
  workAllowed: full_time
  document: @file(C:\Users\Forrun\Downloads\Internship Extension - Saad.pdf)
}

settings {
  encodeUrl: true
  timeout: 0
}
