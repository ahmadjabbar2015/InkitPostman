meta {
  name: Add RTW
  type: http
  seq: 3
}

post {
  url: {{baseURL}}/v1/house/:house/employees/:employee/job/:JobId/rtw
  body: multipartForm
  auth: inherit
}

params:path {
  JobId: 2
  house: 13
  employee: 27
}

body:multipart-form {
  shareCode: XY123Z456
  dateOfCheck: 2026-10-16
  workAllowedUntil: 2026-10-16
  workPermission: skilled_worker_visa
  otherPermissionDetails: 
  workAllowed: part_time_up_to_20_hours_per_week
  document: @file(/home/pirate-king/Downloads/Farhan_Butt%5B1%5D.pdf)
}

settings {
  encodeUrl: true
  timeout: 0
}
