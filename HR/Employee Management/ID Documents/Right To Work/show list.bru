meta {
  name: show list
  type: http
  seq: 4
}

get {
  url: {{baseURL}}/v1/house/:house/employees/:employee/job/:JobId/rtw
  body: none
  auth: inherit
}

params:path {
  JobId: 1
  house: 12
  employee: 26
}

body:multipart-form {
  shareCode: XY123Z456
  dateOfCheck: 2026-10-16
  workAllowedUntil: 2026-10-16
  workPermission: visa
  otherPermissionDetails: 
  workAllowed: full_time
  document: @file(/home/pirate-king/Downloads/Late sitting claim form - Sheet2 (5).pdf)
}

settings {
  encodeUrl: true
  timeout: 0
}
