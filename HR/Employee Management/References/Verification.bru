meta {
  name: Verification
  type: http
  seq: 4
}

post {
  url: {{baseURL}}/v1/house/:house/employee-reference/:reference/verification
  body: multipartForm
  auth: inherit
}

params:path {
  reference: 48
  house: 9
}

body:multipart-form {
  safeguarding_concerns: No, there have never been any safeguarding concerns regarding the applicant during their time here.
  conflict_history: No, I have not experienced any conflicts with the applicant. They maintained a professional attitude at all times.
  other_comments: The applicant was a reliable and cooperative team member who contributed positively to the work environment.
  reason_for_leaving: The applicant left the organization to pursue new career opportunities more aligned with their long-term goals.
}

settings {
  encodeUrl: true
}
