meta {
  name: Verification
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/v1/house/:house/employee-reference/:reference/verification
  body: multipartForm
  auth: inherit
}

params:path {
  reference: 20
  house: 12
}

body:multipart-form {
  safeguardingConcerns: No, there have never been any safeguarding concerns regarding the applicant during their time here.
  conflictHistory: No, I have not experienced any conflicts with the applicant. They maintained a professional attitude at all times.
  otherComments: The applicant was a reliable and cooperative team member who contributed positively to the work environment.
  reasonForLeaving: The applicant left the organization to pursue new career opportunities more aligned with their long-term goals.
  verificationDate: 2025-01-18
  verifiedBy: admin
}

settings {
  encodeUrl: true
  timeout: 0
}
