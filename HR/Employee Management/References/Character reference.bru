meta {
  name: Character reference
  type: http
  seq: 7
}

post {
  url: {{baseURL}}/v1/house/:house/employees/:employee/character-reference
  body: json
  auth: inherit
}

params:path {
  house: 12
  employee: 25
}

body:json {
  {
    "refereeName": "Ahmad Jabbar",
    "refereeEmail": "ahmad@gmail.com",
    "refereeContactNo": "123456766",
    "refereeType": "Most Recent Employer",
    "refereeCompany": "logicode",
    "jobDetailId": 3
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
