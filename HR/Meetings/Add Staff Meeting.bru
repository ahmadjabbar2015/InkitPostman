meta {
  name: Add Staff Meeting
  type: http
  seq: 7
}

post {
  url: {{baseURL}}/v1/house/:house/staff-meetings
  body: json
  auth: bearer
}

params:path {
  house: 14
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
  "title": "Weekly Staff Meeting",
  "mode": "Online",
  "date": "2025-11-05",
  "startTime": "10:00",
  "endTime": "11:00",
  "meetingLink": "https://meet.google.com/abc-defg-hij",
  "agenda": "Discuss weekly performance and updates",
  "attendeeEmployeeJobIds": [2, 3]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
