meta {
  name: Show Staff Meeting
  type: http
  seq: 4
}

get {
  url: {{baseURL}}/v1/house/:house/staff-meetings/:meeting
  body: json
  auth: inherit
}

params:path {
  meeting: 1
  house: 12
}

body:json {
  {
  "houseId": 9,
  "clientId": 9,
  "title": "Weekly Staff Meeting",
  "mode": "Online",
  "date": "2025-11-05",
  "startTime": "10:00",
  "endTime": "11:00",
  "meetingLink": "https://meet.google.com/abc-defg-hij",
  "agenda": "Discuss weekly performance and updates",
  "attendeeEmployeeJobIds": [2, 3]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
