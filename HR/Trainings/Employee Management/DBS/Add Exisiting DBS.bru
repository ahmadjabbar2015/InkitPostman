meta {
  name: Add Exisiting DBS
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/v1/house/:house/employees/:employee/job/:JobId/dbs
  body: multipartForm
  auth: inherit
}

params:path {
  JobId: 1
  house: 8
  employee: 26
}

body:multipart-form {
  dbsInformation: Existing DBS Certificate
  applicationDate: 2023-01-15
  issuedBy: Disclosure & Barring Service
  dbsLevel: Enhanced
  dbsWorkforce: Child Workforce
  issuanceDate: 2023-02-01
