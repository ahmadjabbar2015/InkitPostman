meta {
  name: Show Document
  type: http
  seq: 3
}

get {
  url: {{baseURL}}/v1/house/:house/employees/:employee/job/:JobId/documents/:document
  body: file
  auth: inherit
}

params:path {
  document: 8
  JobId: 1
  house: 8
  employee: 26
}

body:multipart-form {
  type: application_form
  file: @file(/home/pirate-king/Downloads/Late sitting claim form - Sheet2 (5).pdf)
  description: Lorem Ipsum
  : 
}

settings {
  encodeUrl: true
  timeout: 0
}
