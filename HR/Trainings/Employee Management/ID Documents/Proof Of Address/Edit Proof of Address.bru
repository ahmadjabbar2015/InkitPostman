meta {
  name: Edit Proof of Address
  type: http
  seq: 4
}

post {
  url: {{baseURL}}/v1/house/:house/employees/:employee/job/:JobId/proof-of-address/:id
  body: multipartForm
  auth: inherit
}

params:path {
  id: 2
  JobId: 6
  house: 8
  employee: 29
}

body:multipart-form {
  type: utility_bill
  document: @file(/home/pirate-king/Downloads/Late sitting claim form - Sheet2 (5).pdf)
  _method: PUT
}

settings {
  encodeUrl: true
}
