meta {
  name: Add ID Document
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/v1/house/:house/employees/:employee/job/:JobId/id-documents
  body: multipartForm
  auth: inherit
}

params:path {
  JobId: 1
  house: 8
  employee: 29
}

body:multipart-form {
  type: passport
  documentNumber: Disclosure & Barring Service
  countryId: 4
  expiryDate: 2026-12-01
  verifiedBy: Saad Husain
  document: @file()
}

settings {
  encodeUrl: true
  timeout: 0
}
