meta {
  name: Get Complaints
  type: http
  seq: 3
}

get {
  url: {{baseURL}}/v1/house/:house/employees/:employee/job/:JobId/complaints?status=completed
  body: none
  auth: bearer
}

params:query {
  status: completed
}

params:path {
  house: 9
  employee: 28
  JobId: 9
}

auth:bearer {
  token: {{token}}
}
