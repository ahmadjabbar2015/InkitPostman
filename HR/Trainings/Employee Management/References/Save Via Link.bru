meta {
  name: Save Via Link
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/v1/house/:house/employee-reference/:reference/save-via-link
  body: multipartForm
  auth: inherit
}

params:path {
  reference: 50
  house: 9
}

body:multipart-form {
  accessToken: 0199f0ee-176d-7009-90c0-f898168ada60
  referenceReceivedDate: 2025-10-15
  referenceFormSubmission[capacity_known]: Colleague
  referenceFormSubmission[known_duration]: 5 years
  referenceFormSubmission[illness_awareness]: false
  referenceFormSubmission[grievance_history]: None
  referenceFormSubmission[character_description]: Reliable and hardworking
  referenceFormSubmission[criminal_activity]: None
  referenceFormSubmission[vulnerable_concerns]: false
  referenceFormSubmission[safeguarding_issues]: false
  referenceFormSubmission[attitude_towards_others]: Positive and collaborative
  referenceFormSubmission[time_keeping_reliability]: Excellent
  referenceFormSubmission[knowledge_understanding]: Strong understanding of youth issues
  referenceFormSubmission[additional_comments]: Highly recommended
  referenceFormSubmission[would_employ_again]: true
}

settings {
  encodeUrl: true
}
