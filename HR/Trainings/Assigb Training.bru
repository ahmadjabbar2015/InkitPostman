meta {
  name: Assign Training
  type: http
  seq: 4
}

post {
  url: {{baseURL}}/v1/house/:house/trainings/assign
  body: json
  auth: inherit
}

params:path {
  house: 8
}

body:json {
  {
    "employeeJobIds": [2],
    "trainingIds": [1],
    "mode": "Online",
    "type": "Optional",
    "allocationDate": "2025-10-22",
    "training_allocated": false
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}
