meta {
  name: Edit Assign Training
  type: http
  seq: 8
}

put {
  url: {{baseURL}}/v1/house/:house/trainings/assign/1
  body: json
  auth: inherit
}

params:path {
  house: 8
}

body:json {
  {
    "employeeJobIds": [1],
    "trainingIds": [1],
    "mode": "Online",
    "type": "Optional",
    "allocationDate": "2025-10-22",
    "training_allocated": true
    
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}
