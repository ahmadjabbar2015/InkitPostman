meta {
  name: Update Password for First Time Login
  type: http
  seq: 11
}

post {
  url: {{baseURL}}/v1/auth/update-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "firstTimeLogin": true,
    "newPassword": "Ahmad@123$REW",
    "newPassword_confirmation": "Ahmad@123$REW"
  }
}
