meta {
  name: Duty ROTA
  type: http
  seq: 6
}

get {
  url: {{baseURL}}/v1/house/:house/dashboard/duty-rota?startDate=2026-02-17&endDate=2026-02-23
  body: none
  auth: inherit
}

params:query {
  ~startDate: 2026-02-17
  ~endDate: 2026-02-23
}

params:path {
  house: 1
}

docs {
  Get duty ROTA for staff with shift details.
  
  Returns staff members with:
  - Employee details
  - Job title
  - Shifts for the date range
  
  Respects role hierarchy - only shows accessible staff.
  
  Query Parameters:
  - startDate: Start date (default: start of current week)
  - endDate: End date (default: end of current week)
  
  Format: YYYY-MM-DD
}
