meta {
  name: Get Form Structure
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/v1/house/:house/form-templates/:tempateId/structure
  body: none
  auth: bearer
}

params:path {
  tempateId: 11
  house: 12
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "client_id": 1,
    "global_role_id": 4,
    "description": "This is a test house role",
    "is_custom": true
  }
}
